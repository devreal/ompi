# C sources (compiled by the normal C compiler)
sources = \
    op_rocm.h \
    op_rocm_component.c \
    op_rocm_session.c

# The .cpp file is compiled separately by hipcc and linked in as a plain
# object.  Libtool does not know how to compile HIP C++, so we use a custom
# rule.  The resulting object is appended to LIBADD for both DSO and static
# builds.
#
# The persistent kernel uses cooperative-groups grid.sync(), which requires
# relocatable device code (-fgpu-rdc) -- and RDC in turn requires a separate
# *device-link* step before the normal host link, mirroring nvcc -dlink on
# the CUDA side: it resolves the relocatable object's references to
# cooperative-groups device code into a second object, which then needs to
# be linked in alongside the original. Skipping this doesn't produce a build
# failure -- it produces a binary that fails or hangs at kernel launch,
# since the device-side cooperative-groups support was never actually
# linked in.
#
# NOTE: unlike the CUDA -dlink step (long-standing, stable nvcc behavior),
# I was not able to verify this exact hipcc invocation against a real ROCm
# toolchain -- there's no hipcc available in this environment. Confirm
# against `hipcc --help` / your ROCm version's release notes for -fgpu-rdc
# before trusting this; if the flag combination below is wrong, it likely
# either fails to build (safe) or links incompletely and reproduces the
# same launch-time hang this is meant to fix (not safe) -- so please
# actually verify the resulting binary works before relying on it.

rocm_sources  = op_rocm_kernels.hip
EXTRA_DIST    = $(rocm_sources)
CLEANFILES    = op_rocm_kernels.o op_rocm_kernels.lo \
                op_rocm_kernels_dlink.o op_rocm_kernels_dlink.lo

# Include paths forwarded to hipcc so it can find ompi_config.h and the
# op/mca headers.
HIPCC_INCLUDES = \
    -I$(top_srcdir) \
    -I$(top_builddir) \
    -I$(top_srcdir)/ompi \
    -I$(top_builddir)/ompi \
    -I$(top_builddir)/opal \
    -I$(top_builddir)/opal/include \
    -I$(top_srcdir)/ompi/include \
    -I$(top_srcdir)/opal/include

op_rocm_kernels.o: $(srcdir)/op_rocm_kernels.hip \
                   $(srcdir)/op_rocm.h
	$(HIPCC) $(HIPCCFLAGS) -fgpu-rdc $(HIPCC_INCLUDES) \
	    $(op_rocm_CPPFLAGS) \
	    -c $< -o $@

# Wrap the hipcc output in a libtool object file (.lo) so it can be properly
# included in noinst_LTLIBRARIES via LIBADD.
op_rocm_kernels.lo: op_rocm_kernels.o
	@{ echo '# Generated by libtool (HIP kernel)'; \
	   echo "pic_object='op_rocm_kernels.o'"; \
	   echo "non_pic_object='op_rocm_kernels.o'"; \
	} > $@

# Device-link step required by -fgpu-rdc (see the comment above).
op_rocm_kernels_dlink.o: op_rocm_kernels.o
	$(HIPCC) $(HIPCCFLAGS) -fgpu-rdc --hip-link -r $< -o $@

op_rocm_kernels_dlink.lo: op_rocm_kernels_dlink.o
	@{ echo '# Generated by libtool (HIP device-link object)'; \
	   echo "pic_object='op_rocm_kernels_dlink.o'"; \
	   echo "non_pic_object='op_rocm_kernels_dlink.o'"; \
	} > $@

AM_CPPFLAGS = $(op_rocm_CPPFLAGS)

# ----------------------------------------------------------------------------
# DSO build
# ----------------------------------------------------------------------------
if MCA_BUILD_ompi_op_rocm_DSO
component_install = mca_op_rocm.la
component_noinst  =
else
component_install =
component_noinst  = libmca_op_rocm.la
endif

mcacomponentdir = $(ompilibdir)
mcacomponent_LTLIBRARIES = $(component_install)

mca_op_rocm_la_SOURCES  = $(sources)
mca_op_rocm_la_LDFLAGS  = -module -avoid-version $(op_rocm_LDFLAGS)
mca_op_rocm_la_LIBADD   = $(op_rocm_LIBS) op_rocm_kernels.lo op_rocm_kernels_dlink.lo
mca_op_rocm_la_CPPFLAGS = $(op_rocm_CPPFLAGS)

# ----------------------------------------------------------------------------
# Static (convenience library) build
# ----------------------------------------------------------------------------
noinst_LTLIBRARIES = $(component_noinst)

libmca_op_rocm_la_SOURCES  = $(sources)
libmca_op_rocm_la_LDFLAGS  = -module -avoid-version $(op_rocm_LDFLAGS)
libmca_op_rocm_la_LIBADD   = $(op_rocm_LIBS) op_rocm_kernels.lo op_rocm_kernels_dlink.lo
libmca_op_rocm_la_CPPFLAGS = $(op_rocm_CPPFLAGS)
