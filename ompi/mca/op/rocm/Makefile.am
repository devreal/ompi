# C sources (compiled by the normal C compiler)
sources = \
    op_rocm.h \
    op_rocm_component.c \
    op_rocm_session.c

# The .cpp file is compiled separately by hipcc and linked in as a plain
# object.  Libtool does not know how to compile HIP C++, so we use a custom
# rule.  The resulting object is appended to LIBADD for both DSO and static
# builds.
#
# The persistent kernel uses cooperative-groups grid.sync(), which requires
# relocatable device code (-fgpu-rdc) -- and RDC in turn requires a separate
# *device-link* step before the normal host link: hipcc -fgpu-rdc --hip-link
# resolves the relocatable object's references to cooperative-groups device
# code into a device-linked object. Skipping this doesn't produce a build
# failure -- it produces a binary that fails or hangs at kernel launch,
# since the device-side cooperative-groups support was never actually
# linked in.
#
# Unlike nvcc -dlink on the CUDA side, whose output is a small companion
# object meant to be linked *alongside* the original relocatable object,
# hipcc's --hip-link -r output is a complete, self-contained relocatable
# object that already subsumes everything from its input -- linking both
# produces duplicate-symbol errors for every kernel (confirmed against a
# real ROCm toolchain: the first attempt here linked both and hit exactly
# that). Only op_rocm_kernels_dlink.lo -- not op_rocm_kernels.lo -- belongs
# in LIBADD below; op_rocm_kernels.o is kept only as the dlink step's input.

rocm_sources  = op_rocm_kernels.hip
EXTRA_DIST    = $(rocm_sources)
CLEANFILES    = op_rocm_kernels.o op_rocm_kernels_dlink.o op_rocm_kernels_dlink.lo

# Include paths forwarded to hipcc so it can find ompi_config.h and the
# op/mca headers.
HIPCC_INCLUDES = \
    -I$(top_srcdir) \
    -I$(top_builddir) \
    -I$(top_srcdir)/ompi \
    -I$(top_builddir)/ompi \
    -I$(top_builddir)/opal \
    -I$(top_builddir)/opal/include \
    -I$(top_srcdir)/ompi/include \
    -I$(top_srcdir)/opal/include

#
# op_rocm_kernels.o is a relocatable object, not directly linkable on its
# own (unresolved cooperative-groups device references) -- it exists only
# as the device-link step's input below, and is deliberately not wrapped
# in a .lo or added to LIBADD.
op_rocm_kernels.o: $(srcdir)/op_rocm_kernels.hip \
                   $(srcdir)/op_rocm.h
	$(HIPCC) $(HIPCCFLAGS) -fgpu-rdc $(HIPCC_INCLUDES) \
	    $(op_rocm_CPPFLAGS) \
	    -c $< -o $@

# Device-link step required by -fgpu-rdc (see the comment above): the
# complete, self-contained object that actually goes into LIBADD.
op_rocm_kernels_dlink.o: op_rocm_kernels.o
	$(HIPCC) $(HIPCCFLAGS) -fgpu-rdc --hip-link -r $< -o $@

op_rocm_kernels_dlink.lo: op_rocm_kernels_dlink.o
	@{ echo '# Generated by libtool (HIP device-link object)'; \
	   echo "pic_object='op_rocm_kernels_dlink.o'"; \
	   echo "non_pic_object='op_rocm_kernels_dlink.o'"; \
	} > $@

AM_CPPFLAGS = $(op_rocm_CPPFLAGS)

# ----------------------------------------------------------------------------
# DSO build
# ----------------------------------------------------------------------------
if MCA_BUILD_ompi_op_rocm_DSO
component_install = mca_op_rocm.la
component_noinst  =
else
component_install =
component_noinst  = libmca_op_rocm.la
endif

mcacomponentdir = $(ompilibdir)
mcacomponent_LTLIBRARIES = $(component_install)

mca_op_rocm_la_SOURCES  = $(sources)
mca_op_rocm_la_LDFLAGS  = -module -avoid-version $(op_rocm_LDFLAGS)
mca_op_rocm_la_LIBADD   = $(op_rocm_LIBS) op_rocm_kernels_dlink.lo
mca_op_rocm_la_CPPFLAGS = $(op_rocm_CPPFLAGS)

# ----------------------------------------------------------------------------
# Static (convenience library) build
# ----------------------------------------------------------------------------
noinst_LTLIBRARIES = $(component_noinst)

libmca_op_rocm_la_SOURCES  = $(sources)
libmca_op_rocm_la_LDFLAGS  = -module -avoid-version $(op_rocm_LDFLAGS)
libmca_op_rocm_la_LIBADD   = $(op_rocm_LIBS) op_rocm_kernels_dlink.lo
libmca_op_rocm_la_CPPFLAGS = $(op_rocm_CPPFLAGS)
